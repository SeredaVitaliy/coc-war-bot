# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Ключ Clash of Clans API: https://developer.clashofclans.com (привязан к IP сервера)
COC_API_TOKEN=
# Тег клана, например #ABC123
CLAN_TAG=
# ID группы клана (начинается с -100), необязательно
GROUP_CHAT_ID=
# ID темы (топика) в группе, если бот должен отвечать только в ней, необязательно
GROUP_THREAD_ID=
